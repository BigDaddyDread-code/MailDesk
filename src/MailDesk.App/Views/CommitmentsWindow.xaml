<ui:FluentWindow x:Class="MailDesk.App.Views.CommitmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:MailDesk.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:CommitmentsViewModel}"
        Title="Commitments" Width="720" Height="680" MinWidth="520" MinHeight="420"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <ui:FluentWindow.Resources>
        <!-- One fact: checkbox (not for decisions), text, meta, inferred tag, due badge, Add task, Open -->
        <DataTemplate x:Key="FactTemplate" DataType="{x:Type vm:FactRow}">
            <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="8" Background="White" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsDone}" VerticalAlignment="Top" Margin="0,2,10,0" Visibility="{Binding Checkable, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Text}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="#FFF4E5" BorderBrush="#F2B36B" BorderThickness="1" CornerRadius="4" Padding="5,0" Margin="8,2,0,0" VerticalAlignment="Top"
                            ToolTip="Read from context rather than said in so many words"
                            Visibility="{Binding IsInferred, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="inferred" FontSize="10" Foreground="#8A4B08" />
                    </Border>
                    <Border Grid.Column="3" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Top"
                            Visibility="{Binding HasDue, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Background" Value="#FDE7EC" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding DueText}" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="#E01E5A" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                        <Button Content="Add task" FontSize="11" Padding="8,2" Margin="0,0,4,0" Background="Transparent"
                                Visibility="{Binding CanAddTask, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding DataContext.AddTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                        <Button Content="Open" FontSize="11" Padding="8,2" Background="Transparent" ToolTip="Open the message this came from"
                                Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,10,0,6" />
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Commitments" />

        <Grid Grid.Row="1" Margin="16,4,16,4">
            <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,120,0"
                       Text="Everything the analysed conversations established. Open a conversation and click Decisions on its timeline to add to this list." />
            <CheckBox Content="Show done" IsChecked="{Binding ShowDone}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="16,0,16,0">
            <StackPanel>
                <TextBlock Text="Nothing yet. Open a message whose conversation has more than one message and click Decisions on the timeline above it."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="You owe" Style="{StaticResource SectionHeading}" Visibility="{Binding YouOwe.Count, Converter={StaticResource ZeroToVisibility}, ConverterParameter=invert}" />
                <ItemsControl ItemsSource="{Binding YouOwe}" ItemTemplate="{StaticResource FactTemplate}" />

                <TextBlock Text="Owed to you" Style="{StaticResource SectionHeading}" Visibility="{Binding OwedToYou.Count, Converter={StaticResource ZeroToVisibility}, ConverterParameter=invert}" />
                <ItemsControl ItemsSource="{Binding OwedToYou}" ItemTemplate="{StaticResource FactTemplate}" />

                <TextBlock Text="Open questions" Style="{StaticResource SectionHeading}" Visibility="{Binding OpenQuestions.Count, Converter={StaticResource ZeroToVisibility}, ConverterParameter=invert}" />
                <ItemsControl ItemsSource="{Binding OpenQuestions}" ItemTemplate="{StaticResource FactTemplate}" />

                <TextBlock Text="Decided" Style="{StaticResource SectionHeading}" Visibility="{Binding Decisions.Count, Converter={StaticResource ZeroToVisibility}, ConverterParameter=invert}" />
                <ItemsControl ItemsSource="{Binding Decisions}" ItemTemplate="{StaticResource FactTemplate}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="16,6" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,80,0" />
                <Button Content="Close" Click="Close_Click" Padding="12,4" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
