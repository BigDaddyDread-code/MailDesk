<ui:FluentWindow x:Class="MailDesk.App.Views.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:MailDesk.App.ViewModels"
        xmlns:models="clr-namespace:MailDesk.Core.Models;assembly=MailDesk.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Rules" Width="760" Height="520" MinWidth="600" MinHeight="360"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Rules" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="20,4,20,10">
            <TextBlock Text="Rules" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
            <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="Rules run on new Inbox mail after every sync. The first matching rule wins. Use Run now to apply them to what is already in the current folder." />
        </StackPanel>

        <ListView Grid.Row="2" x:Name="RulesList" ItemsSource="{Binding Rules}" Margin="20,0,20,0" BorderThickness="1" BorderBrush="{StaticResource DividerBrush}"
                  SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="10,8" />
                    <EventSetter Event="MouseDoubleClick" Handler="Rule_DoubleClick" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type models:MailRule}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" VerticalAlignment="Top" Margin="0,0,10,0" ToolTip="Enabled"
                                  Command="{Binding DataContext.ToggleRuleEnabledCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Describe}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Top" Margin="12,0,0,0">
                            <Run Text="{Binding HitCount, Mode=OneWay}" /><Run Text=" hits" />
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="3" Margin="20,12,20,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="New rule" Style="{StaticResource TopBarPrimaryButtonStyle}" Command="{Binding NewRuleCommand}" Margin="0,0,8,0" />
                <Button Content="Edit" Click="Edit_Click" Padding="14,6" Margin="0,0,8,0" />
                <Button Content="Delete" Click="Delete_Click" Padding="14,6" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Run now on current folder" Command="{Binding RunRulesNowCommand}" Padding="14,6" Margin="0,0,8,0" />
                <Button Content="Close" Click="Close_Click" Padding="14,6" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
