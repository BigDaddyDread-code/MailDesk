<ui:FluentWindow x:Class="MailDesk.App.Views.RemindersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:MailDesk.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:RemindersViewModel}"
        Title="Reminders" Width="720" Height="620" MinWidth="520" MinHeight="400"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Reminders" />

        <Grid Grid.Row="1" Margin="16,4,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Sent mail nobody answered, commitments past their date, and overdue tasks. Nudge opens a follow-up for you to edit and send." />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="Remind after" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding WaitingDayChoices}" SelectedItem="{Binding WaitingDays}" Width="64" FontSize="12" />
                <TextBlock Text="days without a reply" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
            <CheckBox Grid.Column="2" Content="Show snoozed" IsChecked="{Binding ShowSnoozed}" Margin="14,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="16,0,16,0">
            <StackPanel>
                <TextBlock Text="Nothing needs a nudge." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,12"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Reminders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ReminderRow}">
                            <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8" Background="White" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="#5B2C5C" Margin="0,2,12,0" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                                   Visibility="{Binding Detail, Converter={StaticResource NonEmptyToVisibility}}" />
                                        <TextBlock FontSize="11" Foreground="#E01E5A" Margin="0,2,0,0">
                                            <Run Text="{Binding KindText, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" /><Run Text=" · " Foreground="{StaticResource MutedTextBrush}" /><Run Text="{Binding AgeText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                                        <Button Content="Nudge" Style="{StaticResource TopBarPrimaryButtonStyle}" Margin="0,0,4,0" ToolTip="Open a follow-up to edit and send"
                                                Visibility="{Binding CanNudge, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.NudgeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        <Button Content="Open" FontSize="11" Padding="8,2" Margin="0,0,4,0" Background="Transparent"
                                                Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        <Button Content="3 days" FontSize="11" Padding="8,2" Margin="0,0,4,0" Background="Transparent" ToolTip="Snooze for three days"
                                                Command="{Binding DataContext.Snooze3Command, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        <Button Content="1 week" FontSize="11" Padding="8,2" Margin="0,0,4,0" Background="Transparent" ToolTip="Snooze for a week"
                                                Command="{Binding DataContext.SnoozeWeekCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Padding="6,2" Background="Transparent" BorderThickness="0" ToolTip="Dismiss for good"
                                                Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="16,6" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,80,0" />
                <Button Content="Close" Click="Close_Click" Padding="12,4" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
