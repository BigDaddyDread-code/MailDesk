<ui:FluentWindow x:Class="MailDesk.App.Views.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Add account" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Add account" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Grid.Row="1" Margin="20,8,20,20">
            <TextBlock Text="Account" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ui:TextBox x:Name="NameBox" PlaceholderText="Display name (e.g. Home)" Margin="0,0,0,8" />
            <ui:TextBox x:Name="EmailBox" PlaceholderText="Email address" Margin="0,0,0,8" TextChanged="EmailBox_TextChanged" />
            <ui:TextBox x:Name="UserBox" PlaceholderText="Username (often the full email address)" Margin="0,0,0,8" />
            <ui:PasswordBox x:Name="PasswordBox" PlaceholderText="Password" Margin="0,0,0,16" />

            <TextBlock Text="Incoming (IMAP)" FontWeight="SemiBold" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="ImapHostBox" PlaceholderText="imap.example.com" Margin="0,0,8,0" />
                <ui:TextBox x:Name="ImapPortBox" Grid.Column="1" Text="993" Margin="0,0,8,0" />
                <CheckBox x:Name="ImapSslBox" Grid.Column="2" Content="SSL" IsChecked="True" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="Outgoing (SMTP)" FontWeight="SemiBold" Margin="0,8,0,6" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="SmtpHostBox" PlaceholderText="smtp.example.com" Margin="0,0,8,0" />
                <ui:TextBox x:Name="SmtpPortBox" Grid.Column="1" Text="587" Margin="0,0,8,0" />
                <CheckBox x:Name="SmtpTlsBox" Grid.Column="2" Content="STARTTLS" IsChecked="True" VerticalAlignment="Center" />
            </Grid>

            <TextBlock x:Name="ErrorText" Foreground="#FF6B6B" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" />
                <ui:Button x:Name="SaveButton" Content="Test and save" Appearance="Primary" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
