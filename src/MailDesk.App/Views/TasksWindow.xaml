<ui:FluentWindow x:Class="MailDesk.App.Views.TasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:MailDesk.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:TasksViewModel}"
        Title="Tasks" Width="620" Height="640" MinWidth="460" MinHeight="400"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Tasks" />

        <!-- Add row -->
        <Grid Grid.Row="1" Margin="16,4,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="NewBox" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Add a task and press Enter" KeyDown="NewBox_KeyDown" />
            <DatePicker Grid.Column="1" SelectedDate="{Binding NewDue}" Margin="8,0,0,0" Width="140" ToolTip="Due date (optional)" />
            <Button Grid.Column="2" Content="Add" Style="{StaticResource TopBarPrimaryButtonStyle}" Command="{Binding AddCommand}" Margin="8,0,0,0" />
            <CheckBox Grid.Column="3" Content="Show done" IsChecked="{Binding ShowDone}" Margin="14,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="16,0,16,0">
            <StackPanel>
                <TextBlock Text="Nothing to do. Tidy with agent can suggest tasks from mail that asks for something, or right-click a message and choose Create task." Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,12" Visibility="{Binding Tasks.Count, Converter={StaticResource ZeroToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TaskRow}">
                            <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8" Background="White" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsDone}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Notes}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                                   Visibility="{Binding Notes, Converter={StaticResource NonEmptyToVisibility}}" />
                                        <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" Cursor="Hand"
                                                Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                ToolTip="Open the message this task came from">
                                            <TextBlock Text="{Binding SourceText}" FontSize="12" Foreground="{StaticResource SidebarSelectedBrush}" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Top"
                                            Visibility="{Binding HasDue, Converter={StaticResource BoolToVisibility}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Background" Value="#FDE7EC" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding DueText}" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="#E01E5A" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <Button Grid.Column="3" Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Background="Transparent" BorderThickness="0"
                                            Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Top" ToolTip="Delete task"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="16,6" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                <Button Content="Close" Click="Close_Click" Padding="12,4" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
