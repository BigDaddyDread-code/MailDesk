<ui:FluentWindow x:Class="MailDesk.App.Views.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:MailDesk.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ComposeViewModel}"
        Title="New message" Width="760" Height="640" MinWidth="520" MinHeight="420"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="{Binding Subject, TargetNullValue=New message, FallbackValue=New message}" ShowMaximize="True" ShowMinimize="True" />

        <!-- Headers -->
        <Grid Grid.Row="1" Margin="20,4,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="From" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding FromDisplay}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,4" />

            <TextBlock Grid.Row="1" Text="To" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            <ui:TextBox Grid.Row="1" Grid.Column="1" x:Name="ToBox" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="name@example.com, other@example.com" Margin="0,2" />
            <Button Grid.Row="1" Grid.Column="2" Content="Cc / Bcc" Background="Transparent" BorderThickness="0" Foreground="{StaticResource SidebarSelectedBrush}" Command="{Binding ToggleCcBccCommand}" Margin="6,0,0,0" />

            <TextBlock Grid.Row="2" Text="Cc" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Visibility="{Binding ShowCcBcc, Converter={StaticResource BoolToVisibility}}" />
            <ui:TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Cc, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" Visibility="{Binding ShowCcBcc, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Grid.Row="3" Text="Bcc" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Visibility="{Binding ShowCcBcc, Converter={StaticResource BoolToVisibility}}" />
            <ui:TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Bcc, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" Visibility="{Binding ShowCcBcc, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Grid.Row="4" Text="Subject" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            <ui:TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
        </Grid>

        <!-- Body, with the AI drafting bar above it -->
        <Grid Grid.Row="2" Margin="20,0,20,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Padding="10,8" Margin="0,0,0,8" CornerRadius="6" Background="#F3F0FA" BorderBrush="#D9CDEB" BorderThickness="1"
                    Visibility="{Binding CanDraft, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="The instructions, the subject, the recipients and the quoted message are sent to the model chosen in AI settings. Nothing is sent to anyone else until you click Send.">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#5B2C5C" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" x:Name="AiBox" Text="{Binding AiInstructions, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent"
                             FontSize="13" VerticalContentAlignment="Center" Foreground="{StaticResource TextBrush}" KeyDown="AiBox_KeyDown"
                             IsEnabled="{Binding IsDrafting, Converter={StaticResource Invert}}">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Grid>
                                    <TextBlock Text="Tell the assistant what to say, e.g. 'accept, suggest Thursday instead' (leave empty for a reply)" Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Text.IsEmpty, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibility}}" />
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                    <ui:ProgressRing Grid.Column="2" IsIndeterminate="True" Width="16" Height="16" Margin="8,0" Visibility="{Binding IsDrafting, Converter={StaticResource BoolToVisibility}}" />
                    <Button Grid.Column="3" Content="Draft with AI" Padding="12,4" FontSize="12" Command="{Binding DraftWithAiCommand}"
                            IsEnabled="{Binding IsDrafting, Converter={StaticResource Invert}}" Background="#5B2C5C" Foreground="White" BorderThickness="0" />
                </Grid>
            </Border>
            <Border Grid.Row="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="6">
                <TextBox x:Name="BodyBox" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="10" FontSize="14"
                         Foreground="{StaticResource TextBrush}" SpellCheck.IsEnabled="True" />
            </Border>
        </Grid>

        <!-- Attachments -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Attachments}" Margin="20,0,20,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE723;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Converter={StaticResource FileName}}" VerticalAlignment="Center" />
                            <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Background="Transparent" BorderThickness="0" Padding="4,0" Margin="6,0,0,0"
                                    Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Footer -->
        <Border Grid.Row="4" Padding="20,10" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Send" Style="{StaticResource TopBarPrimaryButtonStyle}" Click="Send_Click" IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}" Margin="0,0,8,0" />
                    <Button Content="Save draft" Click="SaveDraft_Click" Padding="14,6" Margin="0,0,8,0" IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}" />
                    <Button Click="Attach_Click" Padding="10,6" ToolTip="Attach files" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE723;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Attach" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Error}" Foreground="#E01E5A" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Error}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Discard" Click="Discard_Click" Padding="14,6" Background="Transparent" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
