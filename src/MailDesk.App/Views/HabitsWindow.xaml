<ui:FluentWindow x:Class="MailDesk.App.Views.HabitsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:MailDesk.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:HabitsViewModel}"
        Title="Habits" Width="720" Height="620" MinWidth="520" MinHeight="400"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Habits: what you get rid of" />

        <StackPanel Grid.Row="1" Margin="16,4,16,8">
            <TextBlock Text="{Binding Explanation}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
            <Grid Margin="0,10,0,0">
                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <CheckBox Content="Show every sender binned" IsChecked="{Binding ShowAll}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="16,0,16,0">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HabitRow}">
                        <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8" Background="White" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Display}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                        <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHabit}" Value="True">
                                                            <Setter Property="Background" Value="#FDECEF" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Address}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding Percent}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="10,0,0,0" />
                                        <TextBlock Text="{Binding When}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="10,0,0,0" />
                                        <TextBlock Text="{Binding InInboxText}" FontSize="12" Foreground="#8A4B08" Margin="10,0,0,0"
                                                   Visibility="{Binding HasInbox, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <Button Content="Bin now" Padding="10,4" Margin="0,0,6,0" ToolTip="Move this sender's Inbox mail to Trash"
                                            Visibility="{Binding HasInbox, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.TrashNowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    <Button Content="Make rule..." Padding="10,4" Margin="0,0,6,0" ToolTip="Open the rule editor with From equals this address, action Move to Trash. Nothing happens until you save it."
                                            Command="{Binding DataContext.MakeRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    <Button Content="{Binding IgnoreLabel}" Padding="10,4" ToolTip="Ignored senders never appear in Clean up"
                                            Command="{Binding DataContext.ToggleIgnoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <Button Content="Close" HorizontalAlignment="Right" Click="Close_Click" Padding="14,6" />
        </Border>
    </Grid>
</ui:FluentWindow>
