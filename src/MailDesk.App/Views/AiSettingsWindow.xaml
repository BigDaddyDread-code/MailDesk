<ui:FluentWindow x:Class="MailDesk.App.Views.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="AI settings" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="AI settings" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Grid.Row="1" Margin="20,8,20,20">
            <TextBlock Text="Which agent runs 'Tidy with agent'" FontWeight="SemiBold" Margin="0,0,0,6" />
            <RadioButton x:Name="LocalRadio" Content="Local rules (no network, no cost)" GroupName="Agent" Margin="0,0,0,4" />
            <RadioButton x:Name="ClaudeRadio" Content="Claude (Anthropic API)" GroupName="Agent" Margin="0,0,0,4" />
            <RadioButton x:Name="OpenAIRadio" Content="OpenAI (ChatGPT API)" GroupName="Agent" Margin="0,0,0,14" />

            <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Anthropic" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock x:Name="ClaudeKeyStatus" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,4" />
                    <ui:PasswordBox x:Name="ClaudeKeyBox" PlaceholderText="sk-ant-... (leave blank to keep the saved key)" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="ClaudeModelBox" PlaceholderText="Model" Margin="0,0,8,0" />
                        <Button Grid.Column="1" x:Name="ClaudeTestButton" Content="Test" Click="ClaudeTest_Click" Padding="14,6" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="OpenAI" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock x:Name="OpenAIKeyStatus" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,4" />
                    <ui:PasswordBox x:Name="OpenAIKeyBox" PlaceholderText="sk-... (leave blank to keep the saved key)" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="OpenAIModelBox" PlaceholderText="Model" Margin="0,0,8,0" />
                        <Button Grid.Column="1" x:Name="OpenAITestButton" Content="Test" Click="OpenAITest_Click" Padding="14,6" />
                    </Grid>
                </StackPanel>
            </Border>

            <CheckBox x:Name="PreviewsBox" Content="Send the one-line preview of each message along with its headers" Margin="0,0,0,4" />
            <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"
                       Text="Keys are stored encrypted with Windows DPAPI for your user account; ANTHROPIC_API_KEY and OPENAI_API_KEY environment variables are used when no key is saved. Sender, subject and date are sent for the folder being tidied. Full message bodies are never sent. The model can only propose; it cannot move, send or delete anything." />

            <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Padding="14,6" Margin="0,0,8,0" />
                <Button x:Name="SaveButton" Content="Save" Click="Save_Click" Style="{StaticResource TopBarPrimaryButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
