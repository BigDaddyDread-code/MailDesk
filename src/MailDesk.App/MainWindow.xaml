<ui:FluentWindow x:Class="MailDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:MailDesk.App.ViewModels"
        xmlns:models="clr-namespace:MailDesk.Core.Models;assembly=MailDesk.Core"
        xmlns:agent="clr-namespace:MailDesk.Agent;assembly=MailDesk.Agent"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="MailDesk" Height="820" Width="1320" MinWidth="960" MinHeight="540"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round"
        Background="{StaticResource SurfaceBrush}"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar: title bar + toolbar on aubergine -->
        <Border Grid.Row="0" Background="{StaticResource TopBarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ui:TitleBar Grid.Row="0" Title="MailDesk" Foreground="White" />
                <Grid Grid.Row="1" Margin="12,0,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource TopBarPrimaryButtonStyle}" Command="{Binding ComposeNewCommand}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="New message" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopBarButtonStyle}" Command="{Binding AddAccountCommand}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Add account" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopBarButtonStyle}" Command="{Binding SyncCommand}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Sync" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopBarButtonStyle}" Command="{Binding RunTriageCommand}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Tidy with agent" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopBarButtonStyle}" Command="{Binding OpenRulesCommand}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Rules" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopBarButtonStyle}" Command="{Binding OpenCalendarCommand}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Calendar" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopBarButtonStyle}" Command="{Binding OpenTasksCommand}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Tasks" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopBarButtonStyle}" Command="{Binding OpenCommitmentsCommand}" ToolTip="What you owe, what is owed to you and what is still open, across every analysed conversation">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Commitments" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Centered Slack-style search -->
                    <Border Grid.Column="1" Background="{StaticResource SearchFieldBrush}" CornerRadius="6" MaxWidth="560" Height="32" Margin="24,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White" Opacity="0.8" VerticalAlignment="Center" Margin="10,0,6,0" />
                            <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                                     VerticalContentAlignment="Center" Padding="0" FontSize="13"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBox_KeyDown"
                                     ToolTip="Searches subject, sender and preview. A folder name finds everything in that folder; in:finance invoice searches only folders called Finance.">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Grid>
                                            <TextBlock Text="Search mail and folders" Foreground="White" Opacity="0.7" VerticalAlignment="Center" IsHitTestVisible="False"
                                                       Visibility="{Binding Text.IsEmpty, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibility}}" />
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <!-- Scope toggle: all folders of the account, or just the selected one -->
                            <ToggleButton Grid.Column="2" IsChecked="{Binding SearchAllFolders}" Margin="6,3,4,3" Padding="8,0" FontSize="11" Cursor="Hand"
                                          ToolTip="Click to switch between searching all folders and the selected folder only">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="#7A3F7B" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <TextBlock x:Name="Txt" Text="This folder" Foreground="White" VerticalAlignment="Center" FontSize="{TemplateBinding FontSize}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Txt" Property="Text" Value="All folders" />
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarSelectedBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- Save the current query as a sidebar entry; appears once there is something to save -->
                            <Button Grid.Column="3" Command="{Binding SaveSearchCommand}" Background="Transparent" BorderThickness="0" Padding="6,0" Margin="0,0,4,0" Cursor="Hand"
                                    Foreground="White" ToolTip="Save this search to the sidebar"
                                    Visibility="{Binding SearchText, Converter={StaticResource NonEmptyToVisibility}}">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- Command palette: every action, folder and view, type to filter -->
                        <Button Style="{StaticResource TopBarButtonStyle}" Command="{Binding OpenPaletteCommand}" ToolTip="Command palette (Ctrl+K): actions, folders, views and shortcuts" Margin="0,0,6,0">
                            <TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" />
                        </Button>
                        <!-- Reminders bell: unanswered sent mail, overdue commitments and tasks -->
                        <Button Style="{StaticResource TopBarButtonStyle}" Command="{Binding OpenRemindersCommand}" ToolTip="Reminders: sent mail without a reply, overdue commitments and tasks" Margin="0,0,6,0">
                            <Grid>
                                <TextBlock Text="&#xEA8F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" />
                                <Border Background="#E01E5A" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0" Margin="10,-10,-10,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="{Binding HasReminders, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding ReminderCount}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource TopBarButtonStyle}" Command="{Binding OpenAiSettingsCommand}" ToolTip="AI settings">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </Button>
                        <Button Style="{StaticResource TopBarButtonStyle}" Command="{Binding ToggleAgentPaneCommand}" ToolTip="Agent review panel">
                            <TextBlock Text="&#xE90B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Main panes -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180" />
                <ColumnDefinition Width="400" MinWidth="280" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="20,16,20,8">
                        <TextBlock Text="{Binding WorkspaceTitle}" Foreground="White" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding WorkspaceSubtitle}" Foreground="{StaticResource SidebarTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <TextBlock Text="Views" Foreground="{StaticResource SidebarTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,18,0,0" />
                    </StackPanel>
                    <!-- Smart views share SelectedFolder with the folder list: selecting in one clears the other's highlight. -->
                    <ListBox Grid.Row="1" x:Name="ViewList" ItemsSource="{Binding Views}" SelectedItem="{Binding SelectedFolder}"
                             Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SidebarItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FolderItem}">
                                <Grid ToolTip="{Binding Description}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" Background="#4A154B" BorderBrush="{StaticResource SidebarTextBrush}" BorderThickness="1" CornerRadius="9" MinWidth="18" Height="18" Padding="6,0" Margin="8,0,0,0"
                                            Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding UnreadText}" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Saved searches: each re-runs its query when selected. Hidden until the first one is saved. -->
                    <TextBlock Grid.Row="2" Text="Saved searches" Foreground="{StaticResource SidebarTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="20,14,20,0"
                               Visibility="{Binding HasSavedSearches, Converter={StaticResource BoolToVisibility}}" />
                    <ListBox Grid.Row="3" x:Name="SavedSearchList" ItemsSource="{Binding SavedSearches}" SelectedItem="{Binding SelectedFolder}"
                             Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SidebarItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" MaxHeight="180"
                             Visibility="{Binding HasSavedSearches, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.Resources>
                            <ContextMenu x:Key="SavedSearchMenu">
                                <MenuItem Header="Rename..." Command="{Binding PlacementTarget.Tag.RenameSavedSearchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                <MenuItem Header="Replace with current search" Command="{Binding PlacementTarget.Tag.UpdateSavedSearchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"
                                          ToolTip="Points this entry at whatever is in the search box now" />
                                <Separator />
                                <MenuItem Header="Remove from sidebar" Command="{Binding PlacementTarget.Tag.DeleteSavedSearchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                            </ContextMenu>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FolderItem}">
                                <Grid ToolTip="{Binding Description}" ContextMenu="{StaticResource SavedSearchMenu}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="4" Text="Folders" Foreground="{StaticResource SidebarTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="20,14,20,8" />
                    <ListBox Grid.Row="5" x:Name="FolderList" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}"
                             Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SidebarItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AllowDrop="True" DragOver="FolderList_DragOver" DragLeave="FolderList_DragLeave" Drop="FolderList_Drop">
                        <!-- Headers appear only when the code-behind adds a group description (two or more accounts) -->
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource SidebarTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="20,10,20,4" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FolderItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" Background="#E01E5A" CornerRadius="9" MinWidth="18" Height="18" Padding="6,0" Margin="8,0,0,0"
                                            Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding UnreadText}" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Message list -->
            <Grid Grid.Column="1" Background="{StaticResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,1" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ListTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ListSubtitle}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <!-- One row per conversation (newest message of each thread) instead of one per message -->
                        <ToggleButton Grid.Column="1" IsChecked="{Binding ShowConversations}" VerticalAlignment="Top" Margin="8,0,0,0" Padding="8,3" FontSize="11" Cursor="Hand"
                                      ToolTip="Group the list by conversation. Each row is the newest message of its thread; the count shows how many messages it holds."
                                      Visibility="{Binding SelectedFolder.IsView, Converter={StaticResource InvertedBoolToVisibility}, FallbackValue=Collapsed}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bg" CornerRadius="4" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8F2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{StaticResource MutedTextBrush}" x:Name="Icon" />
                                            <TextBlock Text="Conversations" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" x:Name="Label" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#4A154B" />
                                            <Setter TargetName="Bg" Property="BorderBrush" Value="#4A154B" />
                                            <Setter TargetName="Icon" Property="Foreground" Value="White" />
                                            <Setter TargetName="Label" Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>
                </Border>
                <Border Grid.Row="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                    <ListView x:Name="MessageList" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}" SelectionMode="Extended"
                              BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource MessageRowStyle}"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseLeftButtonDown="MessageList_PreviewMouseLeftButtonDown" PreviewMouseMove="MessageList_PreviewMouseMove"
                              KeyDown="MessageList_KeyDown">
                        <ListView.Resources>
                            <ContextMenu x:Key="RowMenu">
                                <MenuItem Header="Toggle flag" Command="{Binding PlacementTarget.Tag.ToggleFlagCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                <!-- Acts on the whole selection when the clicked row is part of it; see TrashMenu_Click. -->
                                <MenuItem Header="Move to Trash" InputGestureText="Del" Click="TrashMenu_Click" />
                                <Separator />
                                <MenuItem Header="Create task from message" Command="{Binding PlacementTarget.Tag.CreateTaskFromMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                <MenuItem Header="Create rule from sender..." Command="{Binding PlacementTarget.Tag.CreateRuleFromSenderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                            </ContextMenu>
                        </ListView.Resources>
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:MessageSummary}">
                                <Grid ContextMenu="{StaticResource RowMenu}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- Avatar -->
                                    <Border Grid.RowSpan="3" Width="36" Height="36" CornerRadius="8" Margin="0,2,12,0" VerticalAlignment="Top"
                                            Background="{Binding AvatarKey, Converter={StaticResource AvatarBrush}}">
                                        <TextBlock Text="{Binding Correspondent, Converter={StaticResource Initial}}" Foreground="White" FontWeight="Bold" FontSize="15"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Correspondent}" FontSize="14" Foreground="{StaticResource TextBrush}"
                                               FontWeight="{Binding IsRead, Converter={StaticResource ReadToFontWeight}}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Conversation size, when more than one message -->
                                        <Border Background="#EEE6EF" BorderBrush="#C9B3CB" BorderThickness="1" CornerRadius="9" MinWidth="22" Height="18" Padding="5,0" Margin="0,0,6,0"
                                                ToolTip="Messages in this conversation"
                                                Visibility="{Binding ThreadBadge, Converter={StaticResource NonEmptyToVisibility}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE8F2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="#5B2C5C" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ThreadBadge}" FontSize="11" Foreground="#5B2C5C" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <!-- Status badge: how long a sent message has waited (Waiting view) -->
                                        <Border Background="#FFF4E5" BorderBrush="#F2B36B" BorderThickness="1" CornerRadius="4"
                                                Padding="5,0" Margin="0,0,6,0" MaxWidth="140"
                                                Visibility="{Binding Badge, Converter={StaticResource NonEmptyToVisibility}}">
                                            <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="#8A4B08" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <!-- Account badge, shown in All inboxes and cross-account search when there is more than one account -->
                                        <Border Background="#E8F1FB" BorderBrush="#9DBBE0" BorderThickness="1" CornerRadius="4"
                                                Padding="5,0" Margin="0,0,6,0" MaxWidth="120"
                                                Visibility="{Binding AccountName, Converter={StaticResource NonEmptyToVisibility}}">
                                            <TextBlock Text="{Binding AccountName}" FontSize="11" Foreground="#1F4E82" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <!-- Folder badge, shown on search results and views -->
                                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="4"
                                                Padding="5,0" Margin="0,0,6,0" MaxWidth="120"
                                                Visibility="{Binding FolderName, Converter={StaticResource NonEmptyToVisibility}}">
                                            <TextBlock Text="{Binding FolderName}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <TextBlock Text="&#xE723;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" Foreground="{StaticResource MutedTextBrush}"
                                                   Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="&#xE7C1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" Foreground="#E01E5A"
                                                   Visibility="{Binding IsFlagged, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Date, Converter={StaticResource DateConverter}}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Subject}" FontSize="13" Foreground="{StaticResource TextBrush}"
                                               FontWeight="{Binding IsRead, Converter={StaticResource ReadToFontWeight}}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Snippet}" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="2" Width="4" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Reader -->
            <Grid Grid.Column="3" Background="{StaticResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Padding="20,14" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                        Visibility="{Binding ReaderMessage, Converter={StaticResource NullToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                            <Button Command="{Binding SummariseCommand}" ToolTip="Summarise with AI: summary, to-dos and reply options" Background="Transparent" BorderThickness="0" Padding="8,4"
                                    IsEnabled="{Binding IsSummarising, Converter={StaticResource Invert}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,6,0" Visibility="{Binding IsSummarising, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#5B2C5C" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ReplyCommand}" ToolTip="Reply" Background="Transparent" BorderThickness="0" Padding="8,4">
                                <TextBlock Text="&#xE97A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                            </Button>
                            <Button Command="{Binding ReplyAllCommand}" ToolTip="Reply all" Background="Transparent" BorderThickness="0" Padding="8,4">
                                <TextBlock Text="&#xE8C2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                            </Button>
                            <Button Command="{Binding ForwardCommand}" ToolTip="Forward" Background="Transparent" BorderThickness="0" Padding="8,4">
                                <TextBlock Text="&#xE8BE;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                            </Button>
                            <Button Click="TrashButton_Click" ToolTip="Move to Trash (Del). Moves every selected message." Background="Transparent" BorderThickness="0" Padding="8,4" Margin="4,0,0,0">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                            </Button>
                        </StackPanel>
                        <Grid Grid.ColumnSpan="2" DataContext="{Binding ReaderMessage}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Top"
                                Background="{Binding FromAddress, Converter={StaticResource AvatarBrush}}">
                            <TextBlock Text="{Binding FromDisplay, Converter={StaticResource Initial}}" Foreground="White" FontWeight="Bold" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Subject}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextBrush}" FontSize="13">
                                <Run Text="{Binding FromDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=" &lt;" Foreground="{StaticResource MutedTextBrush}" /><Run Text="{Binding FromAddress, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" /><Run Text="&gt;" Foreground="{StaticResource MutedTextBrush}" />
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0">
                                <Run Text="To: " /><Run Text="{Binding ToAddresses, Mode=OneWay}" />
                                <Run Text="   " /><Run Text="{Binding Date, Mode=OneWay, StringFormat='{}{0:ddd d MMM yyyy HH:mm}'}" />
                            </TextBlock>
                        </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Conversation timeline: every message in the thread across folders, oldest first; the open one is highlighted -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,8,20,8"
                        Visibility="{Binding HasThread, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel.Resources>
                            <!-- One decision, commitment or open question: icon, text, meta line, inferred tag, Open (source) and Add task -->
                            <DataTemplate x:Key="ThreadItemTemplate" DataType="{x:Type agent:ThreadItem}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="#5B2C5C" Margin="0,3,8,0" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="13" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap">
                                            <Run Text="{Binding Text, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Meta, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#FFF4E5" BorderBrush="#F2B36B" BorderThickness="1" CornerRadius="4" Padding="5,0" Margin="8,2,0,0" VerticalAlignment="Top"
                                            ToolTip="Read from context rather than said in so many words"
                                            Visibility="{Binding IsInferred, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="inferred" FontSize="10" Foreground="#8A4B08" />
                                    </Border>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                                        <Button Content="Add task" FontSize="11" Padding="8,2" Margin="0,0,4,0" Background="Transparent"
                                                Visibility="{Binding CanAddTask, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.AddCommitmentTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        <Button Content="Open" FontSize="11" Padding="8,2" Background="Transparent" ToolTip="Open the message this came from"
                                                Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.OpenInsightSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </StackPanel.Resources>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ThreadTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{Binding AnalyseThreadCommand}" Background="Transparent" BorderThickness="0" Padding="8,2" Cursor="Hand"
                                    ToolTip="Decisions, commitments and open questions in this conversation, each linked to its message (sends the conversation to the model named in AI settings)"
                                    IsEnabled="{Binding IsAnalysingThread, Converter={StaticResource Invert}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:ProgressRing IsIndeterminate="True" Width="12" Height="12" Margin="0,0,6,0" Visibility="{Binding IsAnalysingThread, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="#5B2C5C" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Decisions" FontSize="11" Foreground="#5B2C5C" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Thread}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ThreadEntry}">
                                        <Button Command="{Binding DataContext.OpenThreadEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,4" Margin="0,1" BorderThickness="0" Cursor="Hand"
                                                ToolTip="{Binding Message.Subject}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Background" Value="#E8DDE9" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource DividerBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="22" Height="22" CornerRadius="6" Margin="0,0,8,0" VerticalAlignment="Center"
                                                        Background="{Binding AvatarKey, Converter={StaticResource AvatarBrush}}">
                                                    <TextBlock Text="{Binding Initial, Converter={StaticResource Initial}}" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Who}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="4" Padding="4,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FolderName}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                                </Border>
                                                <TextBlock Grid.Column="3" Text="{Binding Snippet}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="10,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Fill="#E01E5A" Margin="0,0,6,0" Visibility="{Binding IsUnread, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="&#xE723;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" Foreground="{StaticResource MutedTextBrush}"
                                                               Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding When}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- What the conversation decided, promised and left open -->
                        <Border Margin="0,8,0,0" Padding="14,10" CornerRadius="8" Background="#F7F3FB" BorderBrush="#D9CDEB" BorderThickness="1"
                                Visibility="{Binding ThreadInsight, Converter={StaticResource NullToVisibility}}">
                            <Grid DataContext="{Binding ThreadInsight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Counts}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"
                                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="Decided" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,2"
                                               Visibility="{Binding HasDecisions, Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding Decisions}" ItemTemplate="{StaticResource ThreadItemTemplate}" />
                                    <TextBlock Text="Promised" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,2"
                                               Visibility="{Binding HasCommitments, Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding Commitments}" ItemTemplate="{StaticResource ThreadItemTemplate}" />
                                    <TextBlock Text="Still open" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,2"
                                               Visibility="{Binding HasQuestions, Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding OpenQuestions}" ItemTemplate="{StaticResource ThreadItemTemplate}" />
                                    <TextBlock Text="Unclear" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,2"
                                               Visibility="{Binding HasUncertain, Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding Uncertain}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,1">
                                                    <Run Text="? " /><Run Text="{Binding Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0">
                                        <Run Text="{Binding ModelNote, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding AnalysedText, Mode=OneWay}" /><Run Text=". Stated items are in the message's own words; inferred ones are the model's reading. Check before relying on either." />
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Background="Transparent" BorderThickness="0"
                                        VerticalAlignment="Top" Padding="6,2" ToolTip="Hide (the analysis is kept until the conversation grows)"
                                        Command="{Binding DataContext.CloseThreadInsightCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- AI insight card -->
                    <Border Grid.Row="0" Padding="16,12" Margin="16,12,16,4" CornerRadius="8" Background="#F7F3FB" BorderBrush="#D9CDEB" BorderThickness="1"
                            VerticalAlignment="Top"
                            Visibility="{Binding Insight, Converter={StaticResource NullToVisibility}}">
                        <Grid DataContext="{Binding Insight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="#5B2C5C" Margin="0,2,14,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" FontSize="13" />
                                <TextBlock Text="To do" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,2"
                                           Visibility="{Binding HasActions, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding ActionItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="13" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center">
                                                    <Run Text="• " /><Run Text="{Binding Mode=OneWay}" />
                                                </TextBlock>
                                                <Button Grid.Column="1" Content="Add task" FontSize="11" Padding="8,2" Margin="10,0,0,0" Background="Transparent"
                                                        Command="{Binding DataContext.AddActionTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Dates" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,2"
                                           Visibility="{Binding HasEvents, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Events}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type agent:EventSuggestion}">
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="13" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center">
                                                    <Run Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" /><Run Text=" " /><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding WhenText, Mode=OneWay}" />
                                                </TextBlock>
                                                <Button Grid.Column="1" Content="Add to calendar" FontSize="11" Padding="8,2" Margin="10,0,0,0" Background="Transparent"
                                                        Command="{Binding DataContext.AddInsightEventCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Quick replies" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,4"
                                           Visibility="{Binding HasReplies, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding SuggestedReplies}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Padding="10,5" Margin="0,0,6,6" MaxWidth="320" HorizontalContentAlignment="Left" ToolTip="Open a reply with this text"
                                                    Command="{Binding DataContext.UseSuggestedReplyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding Mode=OneWay}" TextWrapping="Wrap" FontSize="12" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ModelNote}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Background="Transparent" BorderThickness="0"
                                    Padding="6,2" VerticalAlignment="Top" ToolTip="Close"
                                    Command="{Binding DataContext.CloseInsightCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Grid>
                    </Border>
                    <!-- Blocked images bar -->
                    <Border Grid.Row="1" Padding="14,8" Background="#FFF8E1" BorderBrush="#F0D28A" BorderThickness="0,0,0,1"
                            Visibility="{Binding HasBlockedImages, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#8A6D1F" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="Images from the sender's server are hidden so they can't see when you open this." FontSize="12"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Content="Show images" Padding="10,4" Margin="10,0,6,0" FontSize="12" Command="{Binding ShowImagesCommand}" />
                            <Button Grid.Column="3" Content="Always show from this sender" Padding="10,4" FontSize="12" Background="Transparent"
                                    Command="{Binding AlwaysShowImagesFromSenderCommand}" />
                        </Grid>
                    </Border>
                    <!-- Invite card -->
                    <Border Grid.Row="2" Padding="16,12" Margin="16,12,16,4" CornerRadius="8" Background="#F3F8FF" BorderBrush="#BBD3F2" BorderThickness="1"
                            Visibility="{Binding Invite, Converter={StaticResource NullToVisibility}}">
                        <Grid DataContext="{Binding Invite}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource SidebarSelectedBrush}" Margin="0,2,14,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Summary}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding WhenText}" Foreground="{StaticResource TextBrush}" Margin="0,2,0,0" />
                                <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap">
                                    <Run Text="{Binding Location, Mode=OneWay}" /><Run Text="  ·  Organiser: " /><Run Text="{Binding OrganizerName, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding DataContext.InviteStatusText, RelativeSource={RelativeSource AncestorType=Border}}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Accept" Style="{StaticResource TopBarPrimaryButtonStyle}" Margin="0,0,6,0"
                                            Command="{Binding DataContext.AcceptInviteCommand, RelativeSource={RelativeSource AncestorType=Border}}" />
                                    <Button Content="Tentative" Padding="12,6" Margin="0,0,6,0"
                                            Command="{Binding DataContext.TentativeInviteCommand, RelativeSource={RelativeSource AncestorType=Border}}" />
                                    <Button Content="Decline" Padding="12,6" Margin="0,0,14,0"
                                            Command="{Binding DataContext.DeclineInviteCommand, RelativeSource={RelativeSource AncestorType=Border}}" />
                                    <Button Content="Add to calendar" Padding="12,6" Margin="0,0,6,0" Background="Transparent"
                                            Command="{Binding DataContext.AddInviteToCalendarCommand, RelativeSource={RelativeSource AncestorType=Border}}" />
                                    <Button Content="Join meeting" Padding="12,6" Background="Transparent" Foreground="{StaticResource SidebarSelectedBrush}"
                                            Visibility="{Binding JoinUrl, Converter={StaticResource NonEmptyToVisibility}}"
                                            Command="{Binding DataContext.JoinInviteCommand, RelativeSource={RelativeSource AncestorType=Border}}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <wv2:WebView2 x:Name="Reader" Grid.Row="3" DefaultBackgroundColor="White" />
                </Grid>
            </Grid>

            <!-- Agent review pane -->
            <Border Grid.Column="4" Width="340" Padding="16" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsAgentPaneOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Ask your mailbox -->
                    <Grid>
                        <TextBlock Text="Ask your mailbox" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                        <Button Content="Clear" HorizontalAlignment="Right" FontSize="11" Padding="8,2" Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource MutedTextBrush}" Command="{Binding ClearChatCommand}"
                                Visibility="{Binding Chat.Count, Converter={StaticResource ZeroToVisibility}, ConverterParameter=invert}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,6" x:Name="ChatScroll">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="12"
                                       Text="Questions like &quot;what did the council say about rates?&quot; or &quot;anything from school this week?&quot; The model searches and reads your mail to answer. It cannot change anything."
                                       Visibility="{Binding Chat.Count, Converter={StaticResource ZeroToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Chat}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChatEntry}">
                                        <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="8" BorderThickness="1" MaxWidth="300">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FromUser}" Value="True">
                                                            <Setter Property="Background" Value="#E8EEF7" />
                                                            <Setter Property="BorderBrush" Value="#C9D6EA" />
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Background" Value="#FDE7EC" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextBrush}" />
                                                <ItemsControl ItemsSource="{Binding Sources}" Margin="0,6,0,0" Visibility="{Binding HasSources, Converter={StaticResource BoolToVisibility}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:MessageSummary}">
                                                            <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,1" HorizontalAlignment="Left" Cursor="Hand"
                                                                    Command="{Binding DataContext.OpenSourceMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                                <TextBlock FontSize="11" Foreground="{StaticResource SidebarSelectedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="270">
                                                                    <Run Text="&#xE715;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" /><Run Text=" " /><Run Text="{Binding FromDisplay, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Subject, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <!-- Offered events and tasks -->
                                                <ItemsControl ItemsSource="{Binding Events}" Margin="0,6,0,0" Visibility="{Binding HasEvents, Converter={StaticResource BoolToVisibility}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:OfferedEvent}">
                                                            <Border Background="#F7F3FB" BorderBrush="#D9CDEB" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                                                <StackPanel>
                                                                    <TextBlock FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap">
                                                                        <Run Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" /><Run Text=" " /><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding WhenText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                                    <Button FontSize="11" Padding="8,2" Margin="0,4,0,0" HorizontalAlignment="Left"
                                                                            Command="{Binding DataContext.AddOfferedEventCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                            IsEnabled="{Binding Added, Converter={StaticResource Invert}}">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button">
                                                                                <Setter Property="Content" Value="Add to calendar" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Added}" Value="True"><Setter Property="Content" Value="Added ✓" /></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding Tasks}" Margin="0,4,0,0" Visibility="{Binding HasTasks, Converter={StaticResource BoolToVisibility}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:OfferedTask}">
                                                            <Border Background="#F7F3FB" BorderBrush="#D9CDEB" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                                                <StackPanel>
                                                                    <TextBlock FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap">
                                                                        <Run Text="&#xE73A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" /><Run Text=" " /><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding DueText, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" />
                                                                    </TextBlock>
                                                                    <Button FontSize="11" Padding="8,2" Margin="0,4,0,0" HorizontalAlignment="Left"
                                                                            Command="{Binding DataContext.AddOfferedTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                            IsEnabled="{Binding Added, Converter={StaticResource Invert}}">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button">
                                                                                <Setter Property="Content" Value="Add task" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Added}" Value="True"><Setter Property="Content" Value="Added ✓" /></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding Note}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"
                                                           Visibility="{Binding Note, Converter={StaticResource NonEmptyToVisibility}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" HorizontalAlignment="Left" Margin="4,0,0,8"
                                             Visibility="{Binding IsAsking, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="QuestionBox" Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ask about your mail..." KeyDown="QuestionBox_KeyDown"
                                    IsEnabled="{Binding IsAsking, Converter={StaticResource Invert}}" />
                        <Button Grid.Column="1" Content="Ask" Style="{StaticResource TopBarPrimaryButtonStyle}" Margin="6,0,0,0" Command="{Binding AskCommand}"
                                IsEnabled="{Binding IsAsking, Converter={StaticResource Invert}}" />
                    </Grid>

                    <!-- Proposals -->
                    <TextBlock Grid.Row="3" Text="Agent proposals" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                    <StackPanel Grid.Row="4" Margin="0,4,0,12">
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="12"
                                   Text="Nothing moves until you approve it. Approved moves go to Trash or Junk, never permanent delete." />
                        <Border Margin="0,8,0,0" Padding="10" CornerRadius="6" Background="White" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                Visibility="{Binding AgentSummary, Converter={StaticResource NonEmptyToVisibility}}">
                            <TextBlock Text="{Binding AgentSummary}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextBrush}" />
                        </Border>
                    </StackPanel>
                    <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Proposals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type agent:AgentProposal}">
                                    <Border Margin="0,0,0,10" Padding="12" CornerRadius="8" Background="White" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Rationale}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource TopBarPrimaryButtonStyle}" Content="Approve" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.ApproveProposalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource TopBarButtonStyle}" Content="Reject" Background="#DDDDDD" Foreground="{StaticResource TextBrush}"
                                                        Command="{Binding DataContext.RejectProposalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Padding="16,6" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" HorizontalAlignment="Right"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
